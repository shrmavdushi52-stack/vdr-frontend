      {/* Document preview side panel */}
      {previewDoc && <div className="fixed inset-0 z-[60] flex justify-end bg-slate-950/40 backdrop-blur-[1px]" onMouseDown={(e) => { if (e.target === e.currentTarget) setPreviewDoc(null); }}><aside className={`flex h-full w-full max-w-2xl flex-col shadow-2xl ${darkMode ? "bg-slate-950 text-slate-100" : "bg-white text-slate-900"}`}><div className={`flex items-start justify-between gap-3 border-b p-5 ${darkMode ? "border-slate-800" : "border-slate-200"}`}><div className="flex min-w-0 items-start gap-3"><span className="rounded-xl bg-blue-50 p-3">{iconFor(previewDoc.type)}</span><div className="min-w-0"><h3 className="break-words font-bold">{previewDoc.name}</h3><p className={`mt-1 text-xs ${muted}`}>{previewDoc.type} Â· {previewDoc.size} Â· {previewDoc.owner}</p><div className="mt-2 flex flex-wrap gap-2"><span className={`rounded-full px-2 py-1 text-xs font-semibold ring-1 ring-inset ${sensitivityClass(previewDoc.sensitivity)}`}>{previewDoc.sensitivity}</span><span className={`rounded-full px-2 py-1 text-xs font-semibold ${statusClass(previewDoc.status)}`}>{previewDoc.status}</span></div></div></div><button onClick={() => setPreviewDoc(null)} aria-label="Close preview" className="rounded-lg p-2 hover:bg-slate-100"><X className="h-5 w-5" /></button></div><div className="flex flex-wrap items-center gap-2 border-b border-slate-100 p-4"><button onClick={() => { setPermissionDoc(structuredClone(previewDoc)); setShowPermissions(true); }} className="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold hover:bg-slate-50"><LockKeyhole className="h-4 w-4" />Permissions</button>{previewDoc.downloadUrl && <a href={previewDoc.downloadUrl} download={previewDoc.name} onClick={() => addAudit("Downloaded", previewDoc)} className="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold hover:bg-slate-50"><Download className="h-4 w-4" />Download</a>}<button onClick={() => { addAudit("Flagged", previewDoc, "Flagged from document preview"); showNotice("Document flagged for compliance review."); }} className="inline-flex items-center gap-2 rounded-xl border border-amber-200 px-3 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50"><AlertTriangle className="h-4 w-4" />Flag for review</button></div><div className="flex-1 overflow-y-auto p-5 sm:p-7"><div className={`mb-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider ${muted}`}><Eye className="h-4 w-4" />Document preview Â· mock renderer</div>{previewDoc.type === "PDF" && previewDoc.downloadUrl ? <iframe src={previewDoc.downloadUrl} title={`PDF preview: ${previewDoc.name}`} className="h-[65vh] min-h-96 w-full rounded-xl border border-slate-200 bg-white" /> : ["PNG", "JPG", "JPEG", "GIF", "WEBP", "SVG"].includes(previewDoc.type) && previewDoc.downloadUrl ? <img src={previewDoc.downloadUrl} alt={previewDoc.name} className="mx-auto max-h-[65vh] max-w-full rounded-xl object-contain shadow" /> : <div className={`min-h-72 rounded-2xl border p-5 sm:p-7 ${darkMode ? "border-slate-800 bg-slate-900" : "border-slate-200 bg-slate-50"}`}><div className="mb-5 flex items-center gap-2"><span className="h-2 w-2 rounded-full bg-rose-400" /><span className="h-2 w-2 rounded-full bg-amber-400" /><span className="h-2 w-2 rounded-full bg-emerald-400" /><span className={`ml-2 text-xs ${muted}`}>{previewDoc.type} preview</span></div>{previewDoc.type === "JSON" ? <pre className="overflow-x-auto whitespace-pre-wrap text-sm">{(() => { try { return JSON.stringify(JSON.parse(previewDoc.content || "{}"), null, 2); } catch { return previewDoc.content || "{\n  \"preview\": \"No JSON content available\"\n}"; } })()}</pre> : <div className="space-y-3 text-sm leading-7">{(previewDoc.content || `Preview is simulated for ${previewDoc.name}.\n\nThis frontend-only prototype does not parse the contents of every uploaded file type. For PDF, DOCX, and spreadsheet files, this area represents the in-app preview experience.`).split("\n").map((line, i) => { const flagged = /compliance note|flagged for review|restricted|do not distribute|must not be represented|outstanding liabilities/i.test(line); return line.trim() ? <p key={i} className={flagged ? "rounded-lg border-l-4 border-amber-400 bg-amber-50 px-3 py-2 font-medium text-amber-950" : ""}>{line}</p> : <div key={i} className="h-1" />; })}</div>}</div>}<div className={`mt-5 rounded-xl border p-4 ${darkMode ? "border-slate-800" : "border-slate-200"}`}><p className="mb-2 text-sm font-semibold">Access summary</p><div className="grid grid-cols-2 gap-3 text-sm"><div><p className={muted}>Folder</p><p className="font-medium">{previewDoc.category}</p></div><div><p className={muted}>Owner</p><p className="font-medium">{previewDoc.owner}</p></div><div><p className={muted}>Last modified</p><p className="font-medium">{previewDoc.modified}</p></div><div><p className={muted}>Roles with view access</p><p className="font-medium">{roles.filter((r) => previewDoc.permissions[r].view).length} of {roles.length}</p></div></div></div></div></aside></div>}

      {/* Permission editor */}
      {showPermissions && permissionDoc && <Modal title="Access permissions" subtitle={permissionDoc.name} onClose={() => { setShowPermissions(false); setPermissionDoc(null); }} darkMode={darkMode}><div className="space-y-5"><div><label className="mb-2 block text-sm font-semibold">Sensitivity label</label><select value={permissionDoc.sensitivity} onChange={(e) => setPermissionDoc({ ...permissionDoc, sensitivity: e.target.value as Sensitivity })} className={inputClass}><option>Confidential</option><option>Public</option><option>Internal Only</option><option>Restricted</option></select><p className={`mt-2 text-xs ${muted}`}>This label is descriptive in this frontend prototype.</p></div><div><div className="mb-2 grid grid-cols-[1.3fr_repeat(3,0.6fr)] gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500"><span>Role</span><span className="text-center">View</span><span className="text-center">Edit</span><span className="text-center">Share</span></div>{roles.map((role) => <div key={role} className={`grid grid-cols-[1.3fr_repeat(3,0.6fr)] items-center gap-2 border-t py-3 ${darkMode ? "border-slate-800" : "border-slate-100"}`}><span className="text-sm font-medium">{role}</span>{(["view", "edit", "share"] as const).map((perm) => <label key={perm} className="flex justify-center"><input type="checkbox" checked={permissionDoc.permissions[role][perm]} onChange={(e) => setPermissionDoc({ ...permissionDoc, permissions: { ...permissionDoc.permissions, [role]: { ...permissionDoc.permissions[role], [perm]: e.target.checked } } })} aria-label={`${role} ${perm}`} className="h-4 w-4 rounded accent-blue-600" /></label>)}</div>)}</div><div className="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs leading-5 text-amber-900"><AlertTriangle className="mr-1 inline h-4 w-4" />UI demonstration only. Enforce real permissions in a trusted backend before handling confidential files.</div><div className="flex justify-end gap-2"><button onClick={() => { setShowPermissions(false); setPermissionDoc(null); }} className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold">Cancel</button><button onClick={savePermissions} className="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Save permissions</button></div></div></Modal>}

      {/* Audit drawer */}
      {showAudit && <div className="fixed inset-0 z-[70] bg-slate-950/40" onMouseDown={(e) => { if (e.target === e.currentTarget) setShowAudit(false); }}><aside className={`ml-auto flex h-full w-full max-w-lg flex-col shadow-2xl ${darkMode ? "bg-slate-950 text-slate-100" : "bg-white text-slate-900"}`}><div className={`flex items-center justify-between border-b p-5 ${darkMode ? "border-slate-800" : "border-slate-200"}`}><div><h3 className="text-lg font-bold">Audit log</h3><p className={`mt-1 text-sm ${muted}`}>Document activity timeline</p></div><button onClick={() => setShowAudit(false)} aria-label="Close audit log" className="rounded-lg p-2 hover:bg-slate-100"><X className="h-5 w-5" /></button></div><div className="flex-1 overflow-y-auto p-5"><AuditTimeline events={auditEvents} darkMode={darkMode} /></div><div className={`border-t p-4 text-xs ${muted} ${darkMode ? "border-slate-800" : "border-slate-200"}`}>Events are stored in this browser session only; this is not a tamper-proof audit service.</div></aside></div>}

      {/* Create folder modal */}
      {showNewFolder && <Modal title="Create a folder" subtitle="Add a category to this demo workspace." onClose={() => { setShowNewFolder(false); setFolderError(""); }} darkMode={darkMode}><form onSubmit={(e) => { e.preventDefault(); createFolder(); }} className="space-y-4"><div><label className="mb-1.5 block text-sm font-semibold">Folder name</label><input autoFocus value={newFolderName} onChange={(e) => { setNewFolderName(e.target.value); setFolderError(""); }} placeholder="e.g. Tax Documents" className={inputClass} />{folderError && <p className="mt-1 text-sm text-rose-600">{folderError}</p>}</div><div className="flex justify-end gap-2"><button type="button" onClick={() => setShowNewFolder(false)} className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold">Cancel</button><button type="submit" className="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white">Create folder</button></div></form></Modal>}

      {/* Upload modal */}
      {showUpload && <Modal title="Upload documents" subtitle="Files are added to this browser session, not a server." onClose={() => setShowUpload(false)} darkMode={darkMode}><div className="space-y-4"><div onDragOver={(e: DragEvent<HTMLDivElement>) => { e.preventDefault(); setDragging(true); }} onDragLeave={() => setDragging(false)} onDrop={(e: DragEvent<HTMLDivElement>) => { e.preventDefault(); setDragging(false); addFiles(e.dataTransfer.files); }} onClick={() => fileInputRef.current?.click()} className={`cursor-pointer rounded-2xl border-2 border-dashed p-7 text-center transition ${dragging ? "border-blue-500 bg-blue-50" : darkMode ? "border-slate-700 hover:border-blue-400" : "border-slate-300 hover:border-blue-400 hover:bg-blue-50/40"}`}><Upload className="mx-auto h-8 w-8 text-blue-600" /><p className="mt-3 font-semibold">Drop files here or browse</p><p className={`mt-1 text-xs ${muted}`}>Multiple files supported Â· common document and image types</p><input ref={fileInputRef} type="file" multiple className="hidden" onChange={(e: ChangeEvent<HTMLInputElement>) => { if (e.target.files) addFiles(e.target.files); e.target.value = ""; }} /></div>{selectedFiles.length > 0 && <div className={`max-h-36 space-y-2 overflow-y-auto rounded-xl border p-3 ${darkMode ? "border-slate-800" : "border-slate-200"}`}>{selectedFiles.map((f, i) => <div key={`${f.name}-${f.size}-${i}`} className="flex items-center gap-2 text-sm">{iconFor(fileType(f.name))}<span className="min-w-0 flex-1 truncate">{f.name}</span><span className={`text-xs ${muted}`}>{formatSize(f.size)}</span><button onClick={() => setSelectedFiles((prev) => prev.filter((_, idx) => idx !== i))} aria-label={`Remove ${f.name}`}><X className="h-4 w-4" /></button></div>)}</div>}<div className="grid gap-3 sm:grid-cols-2"><div><label className="mb-1.5 block text-sm font-semibold">Destination folder</label><select value={uploadFolder} onChange={(e) => setUploadFolder(e.target.value)} className={inputClass}>{categories.map((c) => <option key={c}>{c}</option>)}</select></div><div><label className="mb-1.5 block text-sm font-semibold">Sensitivity</label><select value={uploadSensitivity} onChange={(e) => setUploadSensitivity(e.target.value as Sensitivity)} className={inputClass}><option>Confidential</option><option>Public</option><option>Internal Only</option><option>Restricted</option></select></div></div>{uploadError && <p className="rounded-lg bg-rose-50 p-3 text-sm text-rose-700">{uploadError}</p>}<div className="flex justify-end gap-2"><button onClick={() => setShowUpload(false)} className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold">Cancel</button><button onClick={uploadFiles} className="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Add {selectedFiles.length || ""} file{selectedFiles.length === 1 ? "" : "s"}</button></div></div></Modal>}

      {/* Rename modal */}
      {renameDoc && <Modal title="Rename document" subtitle="The file remains in the same folder." onClose={() => setRenameDoc(null)} darkMode={darkMode}><form onSubmit={(e) => { e.preventDefault(); saveRename(); }} className="space-y-4"><div><label className="mb-1.5 block text-sm font-semibold">New file name</label><input autoFocus value={renameValue} onChange={(e) => setRenameValue(e.target.value)} className={inputClass} /></div><div className="flex justify-end gap-2"><button type="button" onClick={() => setRenameDoc(null)} className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold">Cancel</button><button type="submit" className="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white">Save name</button></div></form></Modal>}
    </main>
  );
}

function StatCard({ icon, label, value, tone }: { icon: ReactNode; label: string; value: number | string; tone: "blue" | "violet" | "rose" | "amber" }) {
  const tones = { blue: "bg-blue-50 text-blue-700", violet: "bg-violet-50 text-violet-700", rose: "bg-rose-50 text-rose-700", amber: "bg-amber-50 text-amber-700" };
  return <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div className="flex items-center justify-between"><span className={`rounded-xl p-3 ${tones[tone]}`}>{icon}</span><MoreHorizontal className="h-5 w-5 text-slate-300" /></div><p className="mt-4 text-sm text-slate-500">{label}</p><p className="mt-1 text-2xl font-bold text-slate-900">{value}</p></div>;
}
function Modal({ title, subtitle, onClose, children, darkMode }: { title: string; subtitle?: string; onClose: () => void; children: ReactNode; darkMode: boolean }) {
  return <div className="fixed inset-0 z-[80] flex items-center justify-center overflow-y-auto bg-slate-950/50 p-4 backdrop-blur-sm" onMouseDown={(e) => { if (e.target === e.currentTarget) onClose(); }}><section className={`my-auto w-full max-w-xl rounded-2xl border p-5 shadow-2xl sm:p-6 ${darkMode ? "border-slate-800 bg-slate-900 text-slate-100" : "border-slate-200 bg-white text-slate-900"}`}><div className="mb-5 flex items-start justify-between gap-3"><div><h3 className="text-lg font-bold">{title}</h3>{subtitle && <p className="mt-1 break-words text-sm text-slate-500">{subtitle}</p>}</div><button onClick={onClose} aria-label="Close modal" className="rounded-lg p-2 hover:bg-slate-100"><X className="h-5 w-5" /></button></div>{children}</section></div>;
}
function AuditTimeline({ events, darkMode }: { events: AuditEvent[]; darkMode: boolean }) {
  const iconForAction = (action: string) => {
    if (action === "Uploaded") return <Upload className="h-4 w-4" />;
    if (action === "Viewed") return <Eye className="h-4 w-4" />;
    if (action === "Downloaded") return <Download className="h-4 w-4" />;
    if (action === "Flagged") return <AlertTriangle className="h-4 w-4" />;
    if (action === "Permission Changed") return <LockKeyhole className="h-4 w-4" />;
    if (action === "Deleted") return <Trash2 className="h-4 w-4" />;
    if (action === "Renamed") return <Pencil className="h-4 w-4" />;
    return <Activity className="h-4 w-4" />;
  };
  return <div className="space-y-0">{events.map((event, index) => <div key={event.id} className="relative flex gap-3 pb-6 last:pb-0"><div className="relative flex w-10 shrink-0 justify-center"><span className={`z-10 flex h-9 w-9 items-center justify-center rounded-full ${event.action === "Flagged" ? "bg-amber-100 text-amber-700" : "bg-blue-100 text-blue-700"}`}>{iconForAction(event.action)}</span>{index < events.length - 1 && <span className={`absolute top-9 h-full w-px ${darkMode ? "bg-slate-800" : "bg-slate-200"}`} />}</div><div className="min-w-0 flex-1 pt-0.5"><div className="flex flex-wrap items-center justify-between gap-2"><p className="font-semibold">{event.action}</p><span className="flex items-center gap-1 text-xs text-slate-500"><Clock3 className="h-3 w-3" />{event.time}</span></div><p className="mt-1 break-words text-sm text-slate-500">{event.documentName}</p><div className="mt-2 flex items-center gap-2"><span className="flex h-6 w-6 items-center justify-center rounded-full bg-slate-200 text-[10px] font-bold text-slate-700">{event.user.split(" ").map((p) => p[0]).join("").slice(0, 2)}</span><span className="text-xs text-slate-500">{event.user}</span></div>{event.detail && <p className="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-900">{event.detail}</p>}</div></div>)}</div>;
}

