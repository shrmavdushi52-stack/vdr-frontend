function formatSize(bytes: number) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
}
function fileType(name: string) {
  const ext = name.split(".").pop() || "FILE";
  return ext.toUpperCase();
}
function iconFor(type: string) {
  const common = "h-5 w-5";
  if (["XLS", "XLSX", "CSV"].includes(type)) return <FileSpreadsheet className={`${common} text-emerald-600`} />;
  if (["PNG", "JPG", "JPEG", "GIF", "WEBP", "SVG"].includes(type)) return <FileImage className={`${common} text-violet-600`} />;
  if (["JSON"].includes(type)) return <FileJson className={`${common} text-amber-600`} />;
  if (["TXT", "MD", "DOC", "DOCX"].includes(type)) return <FileText className={`${common} text-blue-600`} />;
  return <File className={`${common} text-rose-600`} />;
}
function sensitivityClass(value: Sensitivity) {
  switch (value) {
    case "Confidential": return "bg-amber-50 text-amber-800 ring-amber-200";
    case "Public": return "bg-emerald-50 text-emerald-800 ring-emerald-200";
    case "Internal Only": return "bg-blue-50 text-blue-800 ring-blue-200";
    case "Restricted": return "bg-rose-50 text-rose-800 ring-rose-200";
  }
}
function statusClass(value: DocumentItem["status"]) {
  if (value === "Approved") return "bg-emerald-50 text-emerald-700";
  if (value === "Pending") return "bg-amber-50 text-amber-700";
  return "bg-blue-50 text-blue-700";
}
function nowLabel() {
