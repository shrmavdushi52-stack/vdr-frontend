@import "tailwindcss";

:root {
  --background: #f7f6f2;
  --foreground: #202321;
  --surface: #ffffff;
  --muted: #73776f;
  --border: #e7e5de;
  --brand: #405747;
  --brand-dark: #304537;
  --brand-soft: #edf0e9;
  --success: #347052;
  --warning: #a87932;
  --danger: #b54747;
  --accent-sage: #a6b09a;
  --accent-gold: #b49a68;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

input,
select,
textarea {
  color: var(--foreground);
}

input::placeholder,
textarea::placeholder {
  color: #92958c;
}

:focus-visible {
  outline: 3px solid rgb(64 87 71 / 28%);
  outline-offset: 2px;
}

::selection {
  background: #dce4d7;
  color: #202321;
}

* {
  scrollbar-width: thin;
  scrollbar-color: #c9ccc3 transparent;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-thumb {
  background: #c9ccc3;
  border-radius: 20px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Springer-inspired palette: remaining inner component colors */
[class*="bg-blue-600"],
[class*="bg-blue-700"],
[class*="bg-indigo-600"],
[class*="bg-indigo-700"],
[class*="bg-sky-600"],
[class*="bg-cyan-600"] {
  background-color: #405747 !important;
  color: #ffffff !important;
}

[class*="bg-blue-"],
[class*="bg-indigo-"],
[class*="bg-sky-"],
[class*="bg-cyan-"] {
  background-color: #edf0e9 !important;
}

[class*="text-blue-"],
[class*="text-indigo-"],
[class*="text-sky-"],
[class*="text-cyan-"] {
  color: #405747 !important;
}

[class*="border-blue-"],
[class*="border-indigo-"],
[class*="border-sky-"],
[class*="border-cyan-"] {
  border-color: #dce4d7 !important;
}

[class*="ring-blue-"],
[class*="ring-indigo-"],
[class*="ring-sky-"],
[class*="ring-cyan-"] {
  --tw-ring-color: #a6b09a !important;
}

[class*="hover:bg-blue-"]:hover,
[class*="hover:bg-indigo-"]:hover,
[class*="hover:bg-sky-"]:hover,
[class*="hover:bg-cyan-"]:hover {
  background-color: #dce4d7 !important;
}


